{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "独立复核或专业报告接入草案",
  "type": "object",
  "required": [
    "task_id",
    "model_version",
    "model_hash",
    "requirements_revision",
    "data_fingerprint",
    "report_id",
    "engine",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "model_hash": {
      "type": "string"
    },
    "requirements_revision": {
      "type": "integer",
      "minimum": 0
    },
    "data_fingerprint": {
      "type": "string"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    }
  }
}